# Vercel server-only settings. Supply your own values in project Environment Variables.
N009_ENGINE_ORIGIN=
N009_GATEWAY_SECRET=
N009_DASHBOARD_PASSWORD=
N009_FIREBASE_PROJECT_ID=
# Set true on BOTH the external engine and Vercel gateway after deploying workspace isolation.
N009_MULTIUSER=false
# Engine only: bounded capacity for this host, excluding the owner workspace.
N009_MAX_WORKSPACES=4
# Optional engine-only comma-separated outbound routes for multi-user workspaces (assigns separate public IPs so mStock Client IDs do not collide).
N009_WORKSPACE_PROXIES=
N009_WORKSPACE_INTERFACES=

# Persistent engine process only; never use a VITE_ prefix for secrets.
N009_HOST=127.0.0.1
N009_DATA_DIR=
PORT=4310

# Execution engine metadata, not the dashboard browser or tunnel's IP.
# Set hosted only on the persistent hosted engine. No address is assumed static.
N009_EXECUTION_LOCATION=local
N009_EXECUTION_IPV4=

# Vercel-native hosted Paper worker. Server-side secrets only.
# Use cloud instead of N009_ENGINE_ORIGIN when deploying the daemon + database transport.
N009_ENGINE_TRANSPORT=
DATABASE_URL=
N009_STATE_KEY=
