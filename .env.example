# Vercel server-only settings. Supply your own values in project Environment Variables.
N009_ENGINE_ORIGIN=
N009_GATEWAY_SECRET=
N009_DASHBOARD_PASSWORD=

# Persistent engine process only; never use a VITE_ prefix for secrets.
N009_HOST=127.0.0.1
N009_DATA_DIR=
PORT=4310

# Execution engine metadata, not the dashboard browser or tunnel's IP.
# Set hosted only on the persistent hosted engine. No address is assumed static.
N009_EXECUTION_LOCATION=local
N009_EXECUTION_IPV4=

# Vercel-native hosted Paper worker. Server-side secrets only.
# Use cloud instead of N009_ENGINE_ORIGIN when deploying the daemon + database transport.
N009_ENGINE_TRANSPORT=
DATABASE_URL=
N009_STATE_KEY=
