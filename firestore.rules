rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isDocOwner() {
      return isAuthenticated() && resource != null && resource.data.userId == request.auth.uid;
    }
    
    function isNewDocOwner() {
      return isAuthenticated() && request.resource.data.userId == request.auth.uid;
    }

    // User profile access - strict ownership binding
    match /users/{userId} {
      allow get, list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) && (!('uid' in request.resource.data) || request.resource.data.uid == userId);
      allow delete: if isOwner(userId);
    }
    
    // Strategies
    match /strategies/{strategyId} {
      allow get, list: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isNewDocOwner();
      allow update: if isDocOwner() && request.resource.data.userId == request.auth.uid;
      allow delete: if isDocOwner();
    }
    
    // Trades
    match /trades/{tradeId} {
      allow get, list: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isNewDocOwner();
      allow update: if isDocOwner() && request.resource.data.userId == request.auth.uid;
      allow delete: if isDocOwner();
    }
    
    // Brokerages / Broker connections
    match /brokerages/{brokerageId} {
      allow get, list: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isNewDocOwner();
      allow update: if isDocOwner() && request.resource.data.userId == request.auth.uid;
      allow delete: if isDocOwner();
    }
    
    // Orders
    match /orders/{orderId} {
      allow get, list: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isNewDocOwner();
      allow update: if isDocOwner() && request.resource.data.userId == request.auth.uid;
      allow delete: if isDocOwner();
    }
    
    // Notifications
    match /notifications/{notificationId} {
      allow get, list: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isNewDocOwner();
      allow update: if isDocOwner() && request.resource.data.userId == request.auth.uid;
      allow delete: if isDocOwner();
    }
  }
}
