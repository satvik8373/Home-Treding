{
  "name": "nifty-009",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "concurrently -k -n engine,react \"tsx watch server/index.ts\" \"vite --host 127.0.0.1\"",
    "build": "node scripts/build-cloud.mjs && tsc --noEmit -p tsconfig.check.json && vite build",
    "start": "tsx server/index.ts",
    "doctor": "tsx server/doctor.ts",
    "test": "tsx --test tests/strategy.test.ts tests/broker.test.ts tests/controller.test.ts tests/feed.test.ts tests/http.test.ts tests/charts.test.ts tests/backtest.test.ts tests/diagnostics.test.ts tests/historical.test.ts tests/deployment.test.ts tests/transparency.test.ts tests/setup.test.ts tests/cloud.test.ts tests/identity.test.ts",
    "lint": "oxlint",
    "preview": "vite preview",
    "build:vercel": "node scripts/build-vercel.mjs",
    "pretest": "node scripts/build-cloud.mjs"
  },
  "dependencies": {
    "@firebase/app": "0.14.4",
    "@firebase/auth": "1.11.0",
    "csv-parse": "^7.0.3",
    "express": "^5.3.0",
    "jose": "6.1.3",
    "lightweight-charts": "^5.2.1",
    "lucide-react": "^1.61.0",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "esbuild": "^0.28.2",
    "oxlint": "^1.88.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vite": "^8.3.4"
  }
}
