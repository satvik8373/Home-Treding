{
  "compilerOptions": {
    "target": "ES2023", "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext", "moduleResolution": "Bundler", "jsx": "react-jsx",
    "strict": true, "skipLibCheck": true, "noEmit": true,
    "allowImportingTsExtensions": true, "esModuleInterop": true,
    "types": ["node", "vite/client"], "verbatimModuleSyntax": true
  },
  "include": ["src", "server", "shared", "tests", "api", "vite.config.ts"]
}
